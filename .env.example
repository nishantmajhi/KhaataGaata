# ── Neon Postgres (required) ──────────────────────────────────────────────
# neon.com → New project → Connection string → "Pooled connection"
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── Admin login (required) ────────────────────────────────────────────────
# The password your staff type at /admin/login.
#
# AVOID "$" IN THIS VALUE. Next.js expands .env files with dotenv-expand, so
# ADMIN_PASSWORD="SuperU$3r" is read as the literal "SuperU" -- the "$3r" is
# treated as a variable reference and disappears. Escaping it as \$ works
# locally, but variables set in the Vercel dashboard are NOT expanded, so the
# same password would then need different spelling in the two places.
# Letters, digits, "-" and "_" sidestep the problem completely.
ADMIN_PASSWORD="change-me-to-something-long"
# Signs the admin session cookie. Generate with:  openssl rand -base64 32
SESSION_SECRET="change-me-32-bytes-of-random-base64"

# ── Seed data (optional, local only) ──────────────────────────────────────
# Password for the demo account that "npm run db:seed" creates
# (username "demo"). Defaults to "changeme123" if unset. Never seed a
# production database -- the default password is published in the README.
# SEED_STAFF_PASSWORD="changeme123"

# ── Upstash Redis (required in production) ────────────────────────────────
# Leave these empty for local development and rate limiting falls back to an
# in-memory limiter. In production it will NOT fall back: the app refuses to
# start, because a per-instance limiter that resets on every cold start is not
# a limit on a serverless platform, and a deployment with a typo in one of
# these variable names would otherwise look exactly like a working one.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Set to exactly "1" to deploy to production without Redis anyway, accepting
# the in-memory fallback. It exists so that is a decision somebody typed
# rather than an environment variable nobody noticed was missing.
# ALLOW_MEMORY_RATELIMIT="1"
